# Salin file ini jadi .env.deploy (TANPA .contoh) lalu isi nilainya.
# .env.deploy sudah masuk .gitignore — jangan pernah di-commit.

FTP_HOST=ftp.automaeyes.my.id
FTP_USER=
FTP_PASS=

# Pakai FTPS (TLS eksplisit) kalau hosting mendukung — lebih aman daripada FTP polos.
# Isi 1 untuk aktif, 0 untuk FTP biasa.
FTP_TLS=1

# Port FTP (biasanya 21).
FTP_PORT=21

# --- Pemetaan folder di server ---
# REMOTE_PUBLIC = folder yang jadi document root domain (isi dari public/ lokal).
#   cPanel umumnya: /public_html
# REMOTE_SRC = folder untuk src/ (berisi bootstrap.php, lib/, includes/).
#   Ini HARUS cocok dengan require '__DIR__/../src/bootstrap.php' di public/*.php,
#   jadi biasanya sejajar dengan REMOTE_PUBLIC, contoh: /src  (kalau
#   /public_html adalah document root dan src ada di level yang sama)
#   atau /public_html/../src.
REMOTE_PUBLIC=/public_html
REMOTE_SRC=/src

# URL publik, dipakai untuk verifikasi otomatis setelah upload.
SITE_URL=https://automaeyes.my.id
